<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Speed.ORM.Firebird</PackageId>
		<PackageTags>Speed;Faster;orm;sql;micro-orm;firebird</PackageTags>
		<Title>Speed.Firebird</Title>
		<Description>
			High performance database access library.
			Use the Speed application to generate data classes:
			https://github.com/carlosast/Speed-ORM
		</Description>
		<Authors>Carlos Alberto Stefani</Authors>
		<TargetFrameworks>net40;netcoreapp3.1;net5.0;net6.0</TargetFrameworks>
		<Version>2.0.7</Version>
		<!-- Considere incrementar após alterações -->
		<PackageProjectUrl>https://github.com/carlosast/Speed-ORM</PackageProjectUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<AssemblyVersion>1.0.1.18</AssemblyVersion>
		<FileVersion>1.0.1.18</FileVersion>
		<Company>Carlos Alberto Stefanis</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants />
		<DocumentationFile>Speed.Firebird.xml</DocumentationFile>
	</PropertyGroup>

	<!-- Referência moderna para netcoreapp3.1, net5.0, net6.0 -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net40'">
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
	</ItemGroup>

	<!-- Referência antiga apenas para net40 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net40'">
		<PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="5.12.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Speed.Data\Speed.Data.csproj" />
	</ItemGroup>

	<!-- Mono.Security provavelmente só necessário para net40/Mono -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net40'">
		<Reference Include="Mono.Security">
			<HintPath>..\..\Lib\Mono\Mono.Security.dll</HintPath>
		</Reference>
	</ItemGroup>

</Project>