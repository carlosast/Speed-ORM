<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageId>Speed.ORM.OleDb</PackageId>
		<PackageTags>Speed;Faster;orm;sql;micro-orm;oledb</PackageTags>
		<Title>Speed.OleDb</Title>
		<Description>
			High performance database access library.
			Use the Speed application to generate data classes:
			https://github.com/carlosast/Speed-ORM
		</Description>
		<Authors>Carlos Alberto Stefani</Authors>
		<TargetFrameworks>net40;netcoreapp3.1;net5.0;net6.0</TargetFrameworks>
		<Version>3.0.0.0</Version>
		<PackageProjectUrl>https://github.com/carlosast/Speed-ORM</PackageProjectUrl>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<AssemblyVersion>3.0.0</AssemblyVersion>
		<FileVersion>3.0.0.0</FileVersion>
		<Company>Carlos Alberto Stefanis</Company>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<Product>Speed.OleDb</Product>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|AnyCPU'">
		<DefineConstants />
		<DocumentationFile>Speed.OleDb.xml</DocumentationFile>
	</PropertyGroup>

	<!-- Referência moderna apenas para targets que precisam dela -->
	<ItemGroup Condition="'$(TargetFramework)' != 'net40'">
		<PackageReference Include="System.Data.OleDb" Version="10.0.2" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Speed.Data\Speed.Data.csproj" />
	</ItemGroup>

</Project>